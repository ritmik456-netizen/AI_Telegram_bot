# Токен бота от @BotFather
BOT_TOKEN=

# Ключ OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Модели для ответов, советов и решения задач через запятую (бесплатные имеют суффикс :free).
# Бот пробует их по очереди: если первая перегружена, переключается на следующую.
TEXT_MODEL=nvidia/nemotron-3.5-super-vl:free,nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free

# Модель для генерации картинок (платная, нужен баланс на OpenRouter)
IMAGE_MODEL=google/gemini-3.1-flash-lite-image

# Сколько последних сообщений бот помнит в диалоге
HISTORY_LIMIT=20

# Telegram ID админов через запятую (ID виден в «👤 Профиль»)
ADMIN_IDS=

# Модель распознавания голосовых: base — быстрее, но с ошибками; small — точнее, но медленнее
WHISPER_MODEL=small
